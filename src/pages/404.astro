---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Elah" description="This page doesn't exist." path="/404" og="home">
  <section class="sec first" style="min-height:70vh">
    <div class="wrap stack">
      <h1 class="h-xl">This stone missed.</h1>
      <p class="lede">The page you're looking for doesn't exist, or it moved when we rebuilt the site.</p>
      <div class="actions"><a class="btn btn-primary" href="/">Go home</a><a class="btn btn-ghost" href="/node">Meet Node</a></div>
    </div>
  </section>
</Layout>
